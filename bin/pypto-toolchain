# This program is free software, you can redistribute it and/or modify it under the terms and conditions of
# CANN Open Software License Agreement Version 2.0 (the "License").
# Please refer to the License for details. You may not use this file except in compliance with the License.
# THIS SOFTWARE IS PROVIDED ON AN "AS IS" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,
# INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
# See LICENSE in the root of the software repository for the full text of the License.
# -----------------------------------------------------------------------------------------------------------
#
# Deploy and verify PyPTO toolchain bundles.
#
#   pypto-toolchain install <version>    download, check, unpack
#   pypto-toolchain use <version>        point `current` at a version
#   pypto-toolchain verify [--require ...]
#   pypto-toolchain list | current | export | gc

set -uo pipefail

APP_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
TOOLCHAIN_ROOT="${PYPTO_TOOLCHAIN_ROOT:-/opt/pypto/toolchain}"
CACHE_DIR="${PYPTO_TOOLCHAIN_CACHE:-/opt/pypto/cache}"
RELEASE_BASE="https://github.com/pypto-tools/pypto-toolchain/releases/download"

# The libstdc++ floor is set by ptoas, which is NOT part of the bundle: it is
# pinned per-project and fetched per job, yet it links against GLIBCXX_3.4.29
# while the HCE2 system libstdc++ stops at 3.4.28. Carrying a new enough
# libstdc++ is the whole reason GCC is in the bundle at all, so verify asserts
# it rather than assuming the build got it right.
GLIBCXX_REQUIRED="3.4.29"

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; RESET=$'\033[0m'
[ -t 1 ] || { RED=""; GREEN=""; YELLOW=""; DIM=""; RESET=""; }

FAILURES=0
# %-46.46s pads AND truncates: a plain %-46s only pads, so a label carrying a
# path or a version longer than the field pushed the status off the column and
# broke the alignment of the whole report. Truncating keeps the status column
# fixed whatever a host's paths look like.
ok()   { printf '  %s%-46.46s OK%s\n'   "$GREEN" "$1" "$RESET"; }
bad()  { printf '  %s%-46.46s FAILED%s\n%s      %s%s\n' "$RED" "$1" "$RESET" "$DIM" "${2:-}" "$RESET"; FAILURES=$((FAILURES + 1)); }
warn() { printf '  %s%-46.46s WARN%s\n%s      %s%s\n' "$YELLOW" "$1" "$RESET" "$DIM" "${2:-}" "$RESET"; }
info() { printf '%s\n' "$*"; }
die()  { printf '%serror: %s%s\n' "$RED" "$*" "$RESET" >&2; exit 1; }

# Config precedence matches the existing pypto-setup convention, so this tool
# and the scripts already deployed on these hosts read one file, not two.
load_conf() {
    local c
    for c in "${PYPTO_ENV_CONF:-}" "$HOME/.config/pypto-env.conf" /etc/pypto-env.conf; do
        if [ -n "$c" ] && [ -f "$c" ]; then
            # shellcheck disable=SC1090
            . "$c"
            break
        fi
    done
}
load_conf

# Numeric-aware >= over dotted versions. Used for glibc, GLIBCXX and --require
# specs alike; `sort -V` handles 3.4.9 < 3.4.29, which a string compare does not.
version_ge() { [ "$1" = "$2" ] || [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | tail -1)" = "$1" ]; }

# sed, not `head -1`: head exits early, ldd takes SIGPIPE on its next write, and
# under `pipefail` the capture yields 141 and an empty string — reported here as
# "could not detect glibc" on a host that is perfectly fine.
host_glibc() { ldd --version 2>/dev/null | sed -n '1s/.*[^0-9]\([0-9][0-9]*\.[0-9][0-9]*\)$/\1/p'; }

# Locate a CANN install without assuming a version. Order of preference: what
# the operator declared, then the vendor's own "latest" symlink, then any
# versioned install under the conventional root, newest first.
detect_cann() {
    local c
    for c in "${ASCEND_HOME_PATH:-}" "${CANN_ROOT:-}" \
             /usr/local/Ascend/ascend-toolkit/latest; do
        [ -n "$c" ] && [ -f "$c/set_env.sh" ] && { printf '%s' "$c"; return 0; }
    done
    while read -r c; do
        [ -f "$c/set_env.sh" ] && { printf '%s' "$c"; return 0; }
    done < <(find /usr/local/Ascend -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort -Vr)
    return 1
}

# CANN records its version per-component rather than at the root; read whichever
# file this install actually has, and fall back to the directory name.
cann_version() {
    local root="$1" f v=""
    for f in "$root"/*-linux/ascend_toolkit_install.info \
             "$root"/compiler/version.info "$root"/version.info; do
        [ -f "$f" ] || continue
        v="$(grep -m1 -oE '^version=.*' "$f" 2>/dev/null | cut -d= -f2)"
        [ -n "$v" ] && break
    done
    [ -n "$v" ] || v="$(basename "$(readlink -f "$root")")"
    printf '%s' "$v"
}

manifest_env() {
    local version="$1" f="$APP_DIR/manifest/$1.env"
    [ -f "$f" ] || die "no manifest for $version at $f
  The CLI checkout is older than the version you asked for. Refresh it:
    sudo git -C '$APP_DIR' pull"
    printf '%s' "$f"
}

# Read a KEY from a bundle's own MANIFEST (space separated, generated at build).
bundle_field() { awk -v k="$2" '$1 == k {print $2; exit}' "$1/MANIFEST" 2>/dev/null; }

resolve_version() {
    local v="${1:-}"
    if [ -n "$v" ]; then printf '%s' "$v"; return; fi
    [ -L "$TOOLCHAIN_ROOT/current" ] || die "no version selected and no 'current' link; run: pypto-toolchain use <version>"
    basename "$(readlink -f "$TOOLCHAIN_ROOT/current")"
}

# --- preflight ------------------------------------------------------------
# Runs BEFORE any download. A host below the floor must be told so in one line,
# not after pulling 150 MB and failing to exec a binary.
preflight() {
    local floor="$1" arch_want="$2" have
    have="$(host_glibc)"
    if [ -z "$have" ]; then
        bad "glibc detection" "could not parse 'ldd --version'"
        return 1
    fi
    if ! version_ge "$have" "$floor"; then
        bad "glibc $have >= $floor" "This host cannot run this bundle.
      Either upgrade glibc (note ptoas itself needs >= 2.34), or rebuild the
      bundle on an older base image: edit FROM in docker/build.Dockerfile."
        return 1
    fi
    ok "glibc $have >= $floor"

    if [ "$(uname -m)" != "$arch_want" ]; then
        bad "arch $(uname -m)" "bundle is for $arch_want"
        return 1
    fi
    ok "arch $arch_want"

    # /opt/pypto is commonly a symlink onto a roomier filesystem; df follows it.
    local avail_kb
    avail_kb="$(df -Pk "$(dirname "$TOOLCHAIN_ROOT")" 2>/dev/null | awk 'NR==2 {print $4}')"
    if [ -n "$avail_kb" ] && [ "$avail_kb" -lt 2097152 ]; then
        warn "disk $(( avail_kb / 1024 )) MiB free" "a bundle needs ~600 MiB unpacked; consider pointing /opt/pypto at a larger filesystem"
    else
        ok "disk $(( ${avail_kb:-0} / 1024 )) MiB free"
    fi
}

# --- fetch ----------------------------------------------------------------
# Local cache, then an intranet mirror, then the release. Every candidate is
# checked against the same pinned sha256, so where the archive came from is a
# deployment detail rather than a trust boundary — a colleague's scp and a
# release download are equally safe.
# Redraw one line with how much of $1 has arrived, until process $2 exits.
# $3 is the expected total in bytes, or empty when it is not known.
#
# Only when stderr is a terminal: in CI, or under `| tee`, carriage returns turn
# a log into an unreadable single line, so there the download is simply quiet.
watch_download() {
    local file="$1" pid="$2" total="${3:-}" have pct
    [ -t 2 ] || return 0
    while kill -0 "$pid" 2>/dev/null; do
        have="$(stat -c %s "$file" 2>/dev/null || echo 0)"
        if [ -n "$total" ] && [ "$total" -gt 0 ] 2>/dev/null; then
            pct=$(( have * 100 / total ))
            printf '\r  %6d / %d MiB  %3d%%' \
                   "$(( have / 1048576 ))" "$(( total / 1048576 ))" "$pct" >&2
        else
            printf '\r  %6d MiB' "$(( have / 1048576 ))" >&2
        fi
        sleep 2
    done
    # Blank the line so the summary that follows starts clean.
    printf '\r%*s\r' 40 '' >&2
}

# Everything this function reports goes to stderr, and ONLY the resolved path
# goes to stdout: the caller reads it through a command substitution, which
# captures stdout whole. Printing progress there would both hide it from the
# user during a 200 MB download and splice it into the filename the caller then
# hands to tar.
fetch_bundle() {
    local version="$1" arch="$2" sha="$3"
    local name="pypto-toolchain-${version}-${arch}.tar.gz"
    local dest="$CACHE_DIR/$name" tmp
    # Optional: bundles built before this key existed simply show MiB with no
    # percentage rather than failing.
    local expect_bytes=""
    eval "expect_bytes=\${BUNDLE_SIZE_$(printf '%s' "$arch" | tr '[:lower:]' '[:upper:]'):-}"

    if [ -f "$dest" ] && echo "$sha  $dest" | sha256sum -c - >/dev/null 2>&1; then
        info "  cache hit: $dest" >&2
        printf '%s' "$dest"; return 0
    fi

    mkdir -p "$CACHE_DIR" || die "cannot create $CACHE_DIR"
    tmp="$(mktemp "$CACHE_DIR/.${name}.XXXXXX")" || die "cannot create temp file in $CACHE_DIR"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" EXIT

    local url
    for url in ${PYPTO_TOOLCHAIN_MIRROR:+"$PYPTO_TOOLCHAIN_MIRROR/$name"} \
               "$RELEASE_BASE/$version/$name"; do
        info "  fetching $url" >&2
        # curl picks these up on its own; report it so a download that goes an
        # unexpected route is visible. Note sudo clears the environment, so a
        # proxy exported in the caller's shell only survives via `sudo -E`, an
        # inline `sudo https_proxy=... cmd`, or an `export` in pypto-env.conf,
        # which this script sources itself.
        [ -n "${https_proxy:-${HTTPS_PROXY:-}}" ] \
            && info "  via proxy ${https_proxy:-$HTTPS_PROXY}" >&2
        # Progress is measured off the growing temp file rather than taken from
        # curl. --progress-bar cannot cope with this download: -L means the
        # redirect leg carries no Content-Length, so curl paints its unknown-size
        # bouncing indicator, switches to the '#' bar when the real asset starts,
        # and repaints from scratch on every retry — a screenful of noise. Watching
        # the file works the same on any curl and through any number of redirects.
        #
        # curl's own stdout carries only the -w summary (the body goes to -o), and
        # the caller reads this function's stdout as the archive path, so all of it
        # goes to stderr.
        #
        # No --retry-all-errors: it only exists from curl 7.71 and older curl
        # rejects an unknown option outright. Timeouts are generous because this
        # link stalls rather than refuses; --speed-limit/--speed-time still gives
        # up on a transfer that has genuinely died.
        curl -fL -sS --retry 5 --retry-delay 5 \
             --connect-timeout 30 --speed-limit 1024 --speed-time 60 \
             -w '  received %{size_download} bytes in %{time_total}s\n' \
             "$url" -o "$tmp" >&2 &
        local curl_pid=$!
        watch_download "$tmp" "$curl_pid" "$expect_bytes"
        if wait "$curl_pid"; then
            if echo "$sha  $tmp" | sha256sum -c - >/dev/null 2>&1; then
                mv -f "$tmp" "$dest"
                trap - EXIT
                printf '%s' "$dest"; return 0
            fi
            info "  ${YELLOW}sha256 mismatch from this source, trying next${RESET}" >&2
        fi
    done
    rm -f "$tmp"; trap - EXIT
    die "could not obtain a bundle matching sha256 $sha

  Tried the mirror (PYPTO_TOOLCHAIN_MIRROR) and the GitHub release. Release
  assets are served from objects.githubusercontent.com, which several hosts here
  cannot reach even when raw.githubusercontent.com works.

  Either drop the archive in by hand — the cache is checked first and the
  sha256 is verified whatever the source, so any transport is equally safe:
    scp $name <this-host>:/tmp/
    sudo cp /tmp/$name $CACHE_DIR/
    sudo pypto-toolchain install $version

  or serve it from a host that can download it, in /etc/pypto-env.conf:
    PYPTO_TOOLCHAIN_MIRROR=http://<intranet-host>:8080/toolchain"
}

# --- commands -------------------------------------------------------------
cmd_install() {
    local version="${1:-}" force=0
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --force) force=1; shift ;;
            *) die "unknown argument: $1" ;;
        esac
    done
    [ -n "$version" ] || die "usage: pypto-toolchain install <version> [--force]"

    local menv arch arch_upper sha floor prefix
    menv="$(manifest_env "$version")" || exit 1
    # shellcheck disable=SC1090
    . "$menv"
    arch="$(uname -m)"
    arch_upper="$(printf '%s' "$arch" | tr '[:lower:]' '[:upper:]')"
    eval "sha=\${BUNDLE_SHA256_${arch_upper}:-}"
    [ -n "$sha" ] || die "manifest $menv has no BUNDLE_SHA256_${arch_upper}; this version was not built for $arch"
    floor="${GLIBC_FLOOR:?manifest is missing GLIBC_FLOOR}"
    prefix="$TOOLCHAIN_ROOT/$version"

    info "installing pypto-toolchain $version ($arch)"
    preflight "$floor" "$arch" || exit 1

    if [ -d "$prefix" ] && [ "$force" -eq 0 ]; then
        info "  already present at $prefix (use --force to reinstall)"
        exec "$0" verify --version "$version"
    fi

    local archive
    archive="$(fetch_bundle "$version" "$arch" "$sha")" || exit 1
    ok "sha256 $sha"

    mkdir -p "$TOOLCHAIN_ROOT" || die "cannot create $TOOLCHAIN_ROOT (need root?)"
    # Unpack beside the target and swap in, so an interrupted extraction never
    # leaves a half-populated prefix that later looks installed.
    local staging="$TOOLCHAIN_ROOT/.staging-$version.$$"
    rm -rf "$staging"; mkdir -p "$staging"
    if ! tar xzf "$archive" -C "$staging"; then
        rm -rf "$staging"; die "extraction failed"
    fi
    [ -d "$staging/$version" ] || { rm -rf "$staging"; die "archive does not contain '$version/' at its top level"; }
    rm -rf "$prefix"
    mv "$staging/$version" "$prefix"
    rm -rf "$staging"
    ok "unpacked to $prefix"

    "$0" verify --version "$version"
}

cmd_use() {
    local version="${1:-}"
    [ -n "$version" ] || die "usage: pypto-toolchain use <version>"
    [ -d "$TOOLCHAIN_ROOT/$version" ] || die "$version is not installed; run: pypto-toolchain install $version"
    # Atomic swap: a job sourcing activate.sh mid-switch sees either the old or
    # the new link, never a missing one.
    ln -sfn "$version" "$TOOLCHAIN_ROOT/.current.$$" \
        && mv -Tf "$TOOLCHAIN_ROOT/.current.$$" "$TOOLCHAIN_ROOT/current" \
        || die "cannot update $TOOLCHAIN_ROOT/current (need root?)"
    info "current -> $version"
}

# Capability assertion. Consumers state what they need rather than which bundle
# version provides it, so upgrading the bundle never requires editing a
# consumer repository.  Spec: <component><op><version>, e.g. gcc'>='15
check_require() {
    local prefix="$1" spec="$2" comp op want have
    comp="${spec%%[=><]*}"
    op="$(printf '%s' "$spec" | grep -oE '(>=|<=|=)' | head -1)"
    want="${spec##*[=><]}"
    case "$comp" in
        python) have="$(bundle_field "$prefix" PYTHON_VERSION)" ;;
        gcc)    have="$(bundle_field "$prefix" GCC_VERSION)" ;;
        ccache) have="$(bundle_field "$prefix" CCACHE_VERSION)" ;;
        uv)     have="$(bundle_field "$prefix" UV_VERSION)" ;;
        *) bad "require $spec" "unknown component '$comp'"; return ;;
    esac
    [ -n "$have" ] || { bad "require $spec" "MANIFEST has no version for $comp"; return; }

    case "$op" in
        '>=') version_ge "$have" "$want" && ok "require $spec (have $have)" || bad "require $spec" "have $have" ;;
        # `=` means "starts with", so python=3.10 accepts 3.10.18 — pinning a
        # patch level in every consumer would defeat the point of the assertion.
        '=')  case "$have" in "$want"|"$want".*) ok "require $spec (have $have)" ;; *) bad "require $spec" "have $have" ;; esac ;;
        *) bad "require $spec" "unsupported operator (use '=' or '>=')" ;;
    esac
}

cmd_verify() {
    local version="" requires=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --version) version="$2"; shift 2 ;;
            --require) requires+=("$2"); shift 2 ;;
            *) die "unknown argument: $1" ;;
        esac
    done
    version="$(resolve_version "$version")" || exit 1
    local prefix="$TOOLCHAIN_ROOT/$version"
    [ -d "$prefix" ] || die "$version is not installed at $prefix"
    [ -f "$prefix/MANIFEST" ] || die "$prefix has no MANIFEST; the install is incomplete"

    info "verifying pypto-toolchain $version at $prefix"

    local floor arch
    floor="$(bundle_field "$prefix" GLIBC_FLOOR)"
    arch="$(bundle_field "$prefix" BUNDLE_ARCH)"
    preflight "${floor:-0}" "${arch:-$(uname -m)}"

    # The prefix is compiled into the GCC driver and Python's sysconfig, so a
    # bundle unpacked anywhere other than where it was built is subtly broken
    # in ways the smoke tests below may not catch. Check it explicitly.
    local built_prefix
    built_prefix="$(bundle_field "$prefix" BUNDLE_PREFIX)"
    if [ "$built_prefix" = "$prefix" ]; then
        ok "prefix matches build"
    else
        bad "prefix matches build" "built for '$built_prefix' but installed at '$prefix'"
    fi

    # Checksums of the load-bearing binaries: catches a truncated extraction or
    # a file someone replaced by hand.
    local bad_files=0 rel want got
    while read -r _ rel want; do
        got="$(sha256sum "$prefix/$rel" 2>/dev/null | cut -d' ' -f1)"
        [ "$got" = "$want" ] || { bad_files=$((bad_files + 1)); info "      ${DIM}mismatch: $rel${RESET}"; }
    done < <(grep '^FILE_SHA256 ' "$prefix/MANIFEST")
    if [ "$bad_files" -eq 0 ]; then
        ok "component checksums ($(grep -c '^FILE_SHA256 ' "$prefix/MANIFEST") files)"
    else
        bad "component checksums" "$bad_files file(s) do not match MANIFEST"
    fi

    # libstdc++ floor. Not a smoke test of the bundle itself but of the reason
    # it carries GCC: ptoas needs GLIBCXX_3.4.29 and no distro in the fleet
    # provides it.
    local glibcxx
    glibcxx="$(bundle_field "$prefix" GLIBCXX_MAX)"
    glibcxx="${glibcxx#GLIBCXX_}"
    if [ -n "$glibcxx" ] && version_ge "$glibcxx" "$GLIBCXX_REQUIRED"; then
        ok "libstdc++ GLIBCXX_$glibcxx >= $GLIBCXX_REQUIRED"
    else
        bad "libstdc++ GLIBCXX >= $GLIBCXX_REQUIRED" "bundle provides '${glibcxx:-unknown}'; ptoas will not load"
    fi

    # --- smoke tests: prove it runs, not merely that the bytes are right ---
    #
    # Run through activate.sh, because that is how every consumer enters the
    # bundle. The libraries it carries (libffi, libssl, ...) are found via
    # LD_LIBRARY_PATH, so invoking the binaries bare tests a configuration
    # nobody uses — and reports a missing libffi even when the bundle contains
    # it. This also makes activate.sh itself part of what is verified.
    run_in_env() { ( . "$prefix/activate.sh"; "$@" ); }

    local out
    if out="$(run_in_env "$prefix/python/bin/python3.10" \
                -c 'import ssl,ctypes,sqlite3,lzma,venv,ensurepip;print("ok")' 2>&1)" \
       && [ "$out" = "ok" ]; then
        ok "python3.10 stdlib imports"
    else
        bad "python3.10 stdlib imports" "$out"
    fi

    # The bundle ships a compiler, not a C runtime: `as` and `ld` come from the
    # host's binutils, and crt1.o from its glibc development package. Checked
    # separately because their absence surfaces as "cannot find crt1.o" from the
    # linker, which reads like a corrupt bundle rather than a missing package.
    local crt
    crt="$(run_in_env "$prefix/gcc/bin/g++-15" -print-file-name=crt1.o 2>/dev/null)"
    if [ -e "$crt" ] && command -v as >/dev/null 2>&1 && command -v ld >/dev/null 2>&1; then
        ok "host binutils and C runtime present"
    else
        bad "host binutils and C runtime present" \
            "the bundle carries a compiler but not a libc; install binutils and glibc-devel
      (dnf install binutils glibc-devel). Note the bundle assumes an RHEL-family
      layout for these — Debian's multiarch paths are not supported."
    fi

    local probe; probe="$(mktemp -u)"
    if out="$(echo 'int main(){return 0;}' \
                | run_in_env "$prefix/gcc/bin/g++-15" -std=c++23 -x c++ - -o "$probe" 2>&1)" \
       && run_in_env "$probe"; then
        ok "g++-15 compiles and links -std=c++23"
    else
        bad "g++-15 compiles and links -std=c++23" "$out"
    fi
    rm -f "$probe"

    if CCACHE_NAMESPACE=probe run_in_env "$prefix/bin/ccache" -p 2>/dev/null | grep -qi namespace; then
        ok "ccache honours CCACHE_NAMESPACE"
    else
        bad "ccache honours CCACHE_NAMESPACE" \
            "this ccache ignores it silently, which would let a pto-isa bump reuse objects built against the old ISA"
    fi

    if out="$(run_in_env "$prefix/bin/uv" --version 2>&1)"; then ok "uv ($out)"; else bad "uv" "$out"; fi

    # ptoas lives outside the bundle (pinned per project, fetched per job), so
    # this is opportunistic: if the host happens to have one, prove the bundle's
    # libstdc++ actually satisfies it. env -i on purpose — an inherited
    # LD_LIBRARY_PATH would let a host that is really broken look fine.
    local ptoas
    ptoas="$(command -v ptoas 2>/dev/null)"
    if [ -n "$ptoas" ]; then
        if env -i PATH=/usr/bin:/bin \
               LD_LIBRARY_PATH="$prefix/gcc/lib64:$prefix/lib/bundled" \
               "$ptoas" --version >/dev/null 2>&1; then
            ok "ptoas loads against the bundle's libstdc++"
        else
            bad "ptoas loads against the bundle's libstdc++" "$ptoas failed to start under env -i"
        fi
    fi

    # CANN is machine-bound: detected, never deployed. Do not hardcode a version
    # into the search path — installs differ per host, and which version a
    # machine carries is exactly the kind of drift worth showing rather than
    # assuming.
    local cann cann_ver
    cann="$(detect_cann)"
    if [ -n "$cann" ]; then
        cann_ver="$(cann_version "$cann")"
        ok "CANN ${cann_ver:-unknown} at $(basename "$cann")"
        info "      ${DIM}$cann${RESET}"
    else
        warn "CANN not found" \
             "looked at ASCEND_HOME_PATH, CANN_ROOT, /usr/local/Ascend/ascend-toolkit/latest
      and /usr/local/Ascend/*/set_env.sh. Device jobs will fail; simulator and
      codegen jobs are unaffected."
    fi

    local spec
    for spec in "${requires[@]+"${requires[@]}"}"; do check_require "$prefix" "$spec"; done

    echo
    if [ "$FAILURES" -eq 0 ]; then
        printf '%s✅ pypto-toolchain %s ready%s\n' "$GREEN" "$version" "$RESET"
        printf '   source %s/activate.sh\n' "$TOOLCHAIN_ROOT/current"
        return 0
    fi
    printf '%s❌ %d check(s) failed%s\n' "$RED" "$FAILURES" "$RESET"
    return 1
}

cmd_list() {
    [ -d "$TOOLCHAIN_ROOT" ] || { info "no bundles installed under $TOOLCHAIN_ROOT"; return 0; }
    local cur d v
    cur="$(readlink "$TOOLCHAIN_ROOT/current" 2>/dev/null || true)"
    for d in "$TOOLCHAIN_ROOT"/*/; do
        v="$(basename "$d")"
        [ "$v" = "current" ] && continue
        [ -f "$d/MANIFEST" ] || continue
        printf '  %s %-14s gcc %-8s python %-9s ccache %s\n' \
            "$([ "$v" = "$cur" ] && printf '*' || printf ' ')" "$v" \
            "$(bundle_field "$d" GCC_VERSION)" "$(bundle_field "$d" PYTHON_VERSION)" \
            "$(bundle_field "$d" CCACHE_VERSION)"
    done
}

cmd_gc() {
    local keep=2
    while [ $# -gt 0 ]; do
        case "$1" in --keep) keep="$2"; shift 2 ;; *) die "unknown argument: $1" ;; esac
    done
    local cur; cur="$(readlink "$TOOLCHAIN_ROOT/current" 2>/dev/null || true)"
    # Newest first, never touching whatever `current` points at.
    local victims=() v
    while read -r v; do
        [ "$v" = "$cur" ] && continue
        victims+=("$v")
    done < <(find "$TOOLCHAIN_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -Vr | tail -n "+$keep")
    if [ "${#victims[@]}" -eq 0 ]; then info "nothing to remove (keeping $keep, current=$cur)"; return 0; fi
    for v in "${victims[@]}"; do
        info "removing $TOOLCHAIN_ROOT/$v"
        rm -rf "${TOOLCHAIN_ROOT:?}/$v"
    done
}

# Emits `export` lines for eval. Supersedes the hand-deployed pypto-setup
# --export: it re-emits the bundle's own activate.sh and then the host-level
# paths that live in pypto-env.conf but outside the bundle.
cmd_export() {
    local version; version="$(resolve_version "${1:-}")" || exit 1
    cat "$TOOLCHAIN_ROOT/$version/activate.sh"
    [ -n "${PTOAS_ROOT:-}" ]       && printf 'export PTOAS_ROOT=%q\n' "$PTOAS_ROOT"
    [ -n "${ASCEND_HOME_PATH:-}" ] && printf 'export ASCEND_HOME_PATH=%q\n' "$ASCEND_HOME_PATH"
    [ -n "${MODELS_ROOT:-}" ]      && printf 'export MODELS_ROOT=%q\n' "$MODELS_ROOT"
    true
}

# Host readiness, WITHOUT a bundle installed. This is what to run on a machine
# before deploying anything: it reports the facts that differ per host and that
# a rollout has to account for, rather than assuming them.
#
# Everything here is read-only.
cmd_doctor() {
    local floor="2.28" newest
    newest="$(ls "$APP_DIR"/manifest/*.env 2>/dev/null | sed 's|.*/||;s|\.env$||' | sort -V | tail -1)"
    if [ -n "$newest" ]; then
        floor="$(grep -E '^GLIBC_FLOOR=' "$APP_DIR/manifest/$newest.env" | cut -d= -f2)"
        info "against pypto-toolchain ${newest}"
    fi
    info "host $(hostname)  $(uname -m)  $(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME")"

    preflight "$floor" "$(uname -m)"

    # The bundle ships a compiler, not a C library; these come from the machine.
    local crt=""
    if command -v gcc >/dev/null 2>&1; then crt="$(gcc -print-file-name=crt1.o 2>/dev/null)"; fi
    [ -e "$crt" ] || crt="$(ls /usr/lib64/crt1.o /usr/lib/*/crt1.o 2>/dev/null | head -1)"
    if [ -n "$crt" ] && [ -e "$crt" ] && command -v as >/dev/null 2>&1 && command -v ld >/dev/null 2>&1; then
        ok "binutils + C runtime"
    else
        bad "binutils + C runtime" "dnf install binutils glibc-devel"
    fi

    local cann
    cann="$(detect_cann)"
    if [ -n "$cann" ]; then
        ok "CANN $(cann_version "$cann")"
        info "      ${DIM}$cann${RESET}"
    else
        warn "no CANN" "device jobs cannot run here; simulator and codegen jobs can"
    fi

    # Where the 200 MB would land, and whether this host can fetch it at all.
    info "storage $(dirname "$TOOLCHAIN_ROOT") -> $(readlink -f "$(dirname "$TOOLCHAIN_ROOT")" 2>/dev/null || echo '<absent>')"
    # Redact userinfo: a proxy URL routinely carries user:password, and this
    # report is meant to be pasted into a ticket or a chat window.
    local px="${https_proxy:-${HTTPS_PROXY:-}}"
    [ -n "$px" ] && info "proxy $(printf '%s' "$px" | sed 's|//[^/@]*@|//***:***@|')"
    if curl -fsS -o /dev/null --connect-timeout 15 --max-time 30 \
         "$RELEASE_BASE/../../releases" 2>/dev/null; then
        ok "github reachable"
    else
        warn "github not reachable" "sideload into $CACHE_DIR, or set PYPTO_TOOLCHAIN_MIRROR"
    fi

    # --- migration notes ---------------------------------------------------
    # Nothing below gates installing a bundle. These describe the state this
    # machine is in TODAY, before the migration, and they are what decides the
    # order of the remaining work. Both go quiet once it is done: the bundle
    # supplies ccache, and the venvs stop using --system-site-packages.
    echo
    info "migration notes (do not block installing):"

    # The HOST's ccache, not the bundle's — verify covers that one. Below 4.8 it
    # ignores CCACHE_NAMESPACE, so the pto-isa cache scoping in CI is a silent
    # no-op here today. And if the working one came from conda, it disappears
    # the moment conda does, which is why conda is removed last.
    if command -v ccache >/dev/null 2>&1; then
        local cc_path cc_ver
        cc_path="$(command -v ccache)"; cc_ver="$(ccache --version | sed -n '1s/[^0-9]*\([0-9][0-9.]*\).*/\1/p')"
        if CCACHE_NAMESPACE=probe ccache -p 2>/dev/null | grep -qi namespace; then
            ok "ccache $cc_ver honours CCACHE_NAMESPACE"
        else
            warn "ccache $cc_ver ignores CCACHE_NAMESPACE" "the bundle supplies 4.10; until then pto-isa cache scoping is a no-op here"
        fi
        info "      ${DIM}$cc_path${RESET}"
    else
        warn "no ccache on PATH" "the bundle supplies one"
    fi

    # conda is not a fault, but which envs carry pypto is: with the venvs those
    # CI jobs build on --system-site-packages, a failed install in the venv is
    # masked by the copy in the base env. Also a pre-migration condition.
    local conda_root="${CONDA_ROOT:-$HOME/miniconda3}" e n
    if [ -d "$conda_root/envs" ]; then
        for e in "$conda_root"/envs/*/; do
            [ -x "$e/bin/python" ] || continue
            n="$(basename "$e")"
            if "$e/bin/python" -c 'import pypto' 2>/dev/null; then
                warn "conda env '$n' has pypto installed" "with --system-site-packages it can shadow a venv build; removed by the migration"
            fi
        done
        info "conda at $conda_root ($(ls -1 "$conda_root/envs" | wc -l) envs)"
    else
        info "no conda under $conda_root"
    fi


    echo
    [ "$FAILURES" -eq 0 ] && printf '%s✅ ready to install a bundle%s\n' "$GREEN" "$RESET" \
                          || printf '%s❌ %d issue(s) block installing a bundle%s\n' "$RED" "$FAILURES" "$RESET"
    return $(( FAILURES > 0 ))
}

usage() {
    cat <<'EOF'
pypto-toolchain — deploy and verify PyPTO toolchain bundles

  doctor                          host readiness, before any bundle is installed
  install <version> [--force]     download, preflight, unpack, verify
  use <version>                   point `current` at an installed version
  verify [--version V] [--require SPEC]...
                                  checksums + smoke tests; SPEC is e.g.
                                  python=3.10, gcc'>='15, ccache'>='4.8
  list                            installed versions (* = current)
  current                         print the selected version
  export [version]                emit `export` lines for eval
  gc [--keep N]                   remove old versions (default keep 2)

Paths come from /etc/pypto-env.conf (or ~/.config/pypto-env.conf):
  PYPTO_TOOLCHAIN_ROOT    default /opt/pypto/toolchain
  PYPTO_TOOLCHAIN_CACHE   default /opt/pypto/cache
  PYPTO_TOOLCHAIN_MIRROR  optional intranet base URL, tried before the release
EOF
}

case "${1:-}" in
    doctor)  shift; cmd_doctor "$@" ;;
    install) shift; cmd_install "$@" ;;
    use)     shift; cmd_use "$@" ;;
    verify)  shift; cmd_verify "$@" ;;
    list)    shift; cmd_list "$@" ;;
    current) resolve_version "" && echo ;;
    export)  shift; cmd_export "$@" ;;
    gc)      shift; cmd_gc "$@" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command: $1 (try --help)" ;;
esac
